# ---------------------------------------------------------------------------
# LTI CONTENT PROVIDER  (LTI 1.3 role: TOOL)
# ---------------------------------------------------------------------------
PORT=4000
PROVIDER_BASE_URL=http://localhost:4000

# Postgres (docker-compose maps the container's 5432 to host 5433)
DATABASE_URL=postgres://lti:lti@localhost:5433/lti_provider

# RSA keypair used to sign Deep Linking responses and client_credentials
# assertions sent to the platform. PRIVATE KEY IS BACKEND-ONLY - it is never
# served to, imported by, or referenced from the React frontend.
LTI_PRIVATE_KEY_PATH=./keys/private.pem
LTI_PUBLIC_KEY_PATH=./keys/public.pem
LTI_KEY_ID=provider-key-1

# Secret used to sign the short-lived "content session" JWT handed to the
# in-iframe player so it can call the activity API without third-party cookies.
CONTENT_SESSION_SECRET=change-me-provider-content-session-secret
CONTENT_SESSION_TTL_SECONDS=14400

# Password for the provider-side activity log dashboard (/admin).
ADMIN_PASSWORD=admin123

# Largest single file the admin content uploader will accept (streamed to ./media).
MAX_UPLOAD_MB=512

# Origins allowed to embed the provider's player in an iframe (CSP frame-ancestors).
ALLOWED_FRAME_ANCESTORS=http://localhost:4001,http://localhost:5174

# A viewing session with no heartbeat for this long is auto-closed by the reaper
# and recorded as CONTENT_VIEW_ENDED with end_reason='timeout'.
VIEW_HEARTBEAT_TIMEOUT_SECONDS=90
VIEW_REAPER_INTERVAL_SECONDS=30

# OIDC state / nonce lifetime (seconds)
LTI_STATE_TTL_SECONDS=600
LTI_NONCE_TTL_SECONDS=600
# Maximum accepted age of an incoming id_token (seconds)
LTI_MAX_TOKEN_AGE_SECONDS=300
