{
  "name": "lti-content-provider",
  "version": "1.0.0",
  "private": true,
  "description": "LTI 1.3 Tool (Content Provider) - admin uploads all course content here; owns every content item and all activity logging",
  "type": "module",
  "engines": { "node": ">=20.19" },
  "scripts": {
    "keys:generate": "tsx scripts/generate-keys.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:register": "tsx scripts/db-register.ts",
    "db:reset-content": "tsx scripts/db-reset-content.ts",
    "registration:print": "tsx scripts/print-registration.ts",
    "setup": "npm run keys:generate && npm run db:migrate && npm run db:register",
    "frontend:install": "npm --prefix frontend install",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:dev": "npm --prefix frontend run dev",
    "build": "tsc -p tsconfig.json && npm run frontend:build",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jose": "^6.2.9",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
